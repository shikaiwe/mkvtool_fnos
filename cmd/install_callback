#!/bin/bash
# 应用文件安装后执行：fnpack 打包在 Windows 上无法保留执行位，这里补齐运行所需权限。
set -u
TARGET="${TRIM_APPDEST:-/var/apps/mkvtoolnix/target}"
chmod +x "$TARGET"/bin/* 2>/dev/null
mkdir -p "${TRIM_PKGVAR:-/var/apps/mkvtoolnix/var}/jobs" \
         "${TRIM_PKGETC:-/var/apps/mkvtoolnix/etc}" \
         "${TRIM_PKGTMP:-/tmp}" 2>/dev/null
exit 0
